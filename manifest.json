{
  "manifest_version": 3,
  "name": "Smart Browser Performance Monitor",
  "version": "1.0.0",
  "description": "Monitor and optimize browser performance with intelligent tab management",
  "permissions": [
    "tabs",
    "processes",
    "system.memory",
    "storage",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}